---
interface Props {
  loai: 'subsequence' | 'cantor' | 'integral' | 'continuity' | 'limits' | 'metric' | 'connected' | 'power' | 'uniform' | 'bernstein';
}
const { loai } = Astro.props;
const nhan = {
  subsequence: 'Dãy 2 + (−1)ⁿ: chỉ số chẵn cho 3, chỉ số lẻ cho 1',
  cantor: 'Bốn bước đầu xây tập Cantor bằng cách bỏ các khoảng giữa',
  integral: 'Hình chữ nhật nằm trên đồ thị giảm 1/x² ở mỗi khoảng [n,n+1]',
  continuity: 'Đồ thị x² gần điểm (1,1) và dải sai số đầu ra',
  limits: 'Hàm x+2 bị bỏ điểm tại 0 vẫn có giới hạn bằng 2',
  metric: 'Hai điểm trong mặt phẳng: khoảng cách Euclid là độ dài đoạn nối',
  connected: 'Một khoảng liền mạch và hai khoảng bị tách bởi một khe hở',
  power: 'Chuỗi lũy thừa hội tụ trong khoảng bán kính R; hai đầu mút xét riêng',
  uniform: 'Các đồ thị xⁿ trên [0,1] và trên [0,0,8]: miền quyết định hội tụ đều',
  bernstein: 'Đa thức Bernstein B₂ của x² nằm trên x² với sai số tối đa 1/8',
}[loai];
const path = (f: (x: number) => number, a = 0, b = 1, scale = 170) =>
  Array.from({ length: 101 }, (_, i) => {
    const x = a + (b - a) * i / 100;
    return `${i ? 'L' : 'M'}${60 + (x - a) / (b - a) * 480},${230 - scale * f(x)}`;
  }).join(' ');
let segments = [[0, 1]];
const cantor = Array.from({ length: 4 }, () => {
  const row = segments;
  segments = segments.flatMap(([a, b]) => [[a, a + (b-a)/3], [b - (b-a)/3, b]]);
  return row;
});
---
<figure data-hinh-ross={loai}>
  <svg viewBox="0 0 600 300" role="img" aria-label={nhan}>
    <title>{nhan}</title>
    {loai === 'subsequence' && <>
      <path d="M50 25V240H550" class="net" />
      {[1,3].map(v => <><line x1="50" x2="550" y1={230-v*55} y2={230-v*55} class="bien" /><text x="20" y={235-v*55}>{v}</text></>)}
      {Array.from({length:24}, (_,i) => <circle cx={70+i*19} cy={230-(2+(-1)**(i+1))*55} r="4" class="diem" />)}
      <text x="80" y="275">Hai nhánh có hai giới hạn khác nhau</text>
    </>}
    {loai === 'cantor' && <>
      {cantor.map((row,i) => <>
        <text x="12" y={58+i*52}>{i}</text>
        {row.map(([a,b]) => <line x1={60+a*480} x2={60+b*480} y1={52+i*52} y2={52+i*52} class="doan" />)}
      </>)}
      <text x="80" y="275">Tập đóng lồng nhau; giao là tập Cantor</text>
    </>}
    {loai === 'integral' && <>
      <path d="M60 35V230H555" class="net" />
      {Array.from({length:6},(_,i) => <rect x={60+i*80} y={230-170/(i+1)**2} width="80" height={170/(i+1)**2} class="vung" />)}
      <path d={path(x=>1/x**2,1,7)} class="duong" />
      <text x="250" y="65">f(x) = 1/x²</text>
      <text x="75" y="275">Hàm dương, giảm: so tổng với diện tích</text>
    </>}
    {loai === 'continuity' && <>
      <rect x="60" y="128" width="480" height="34" class="vung" />
      <path d="M60 30V230H550" class="net" />
      <path d={path(x=>x*x,0,1.6,85)} class="duong" />
      <circle cx="360" cy="145" r="5" class="diem" />
      <text x="90" y="115">Dải đầu ra quanh f(1) = 1</text>
      <text x="75" y="275">Chọn δ để đầu ra ở trong dải ε</text>
    </>}
    {loai === 'limits' && <>
      <path d="M300 30V245M60 230H550" class="net" />
      <path d="M90 210L510 70" class="duong" />
      <circle cx="300" cy="140" r="7" class="rong" />
      <text x="320" y="125">Lỗ tại (0,2)</text>
      <text x="75" y="275">Giới hạn không phụ thuộc giá trị tại điểm</text>
    </>}
    {loai === 'metric' && <>
      <path d="M70 35V235H550" class="net" />
      <path d="M130 190L450 70" class="duong" />
      <path d="M130 190H450V70" class="bien" />
      <circle cx="130" cy="190" r="5" class="diem" /><circle cx="450" cy="70" r="5" class="diem" />
      <text x="110" y="220">p</text><text x="460" y="65">q</text>
      <text x="200" y="100">d(p,q)</text><text x="75" y="275">Đổi |x−a| thành khoảng cách d(x,a)</text>
    </>}
    {loai === 'connected' && <>
      <line x1="70" x2="530" y1="90" y2="90" class="doan" />
      <text x="75" y="60">Một khoảng: liên thông</text>
      <line x1="70" x2="260" y1="190" y2="190" class="doan" />
      <line x1="350" x2="530" y1="190" y2="190" class="doan" />
      <text x="75" y="240">Hai phần tách nhau: không liên thông</text>
    </>}
    {loai === 'power' && <>
      <line x1="50" x2="550" y1="145" y2="145" class="net" />
      <line x1="130" x2="470" y1="145" y2="145" class="doan" />
      {[130,470].map(x=><circle cx={x} cy="145" r="8" class="rong" />)}
      <text x="105" y="110">c−R</text><text x="290" y="110">c</text><text x="450" y="110">c+R</text>
      <text x="180" y="195">Hội tụ tuyệt đối bên trong</text>
      <text x="110" y="250">Hai đầu mút phải kiểm tra riêng</text>
    </>}
    {loai === 'uniform' && <>
      <path d="M60 30V230H550" class="net" />
      {[1,4,16,64].map(n => <path d={path(x=>x**n)} class="duong" style={`opacity:${.4+Math.log2(n+1)/12}`} />)}
      <line x1="444" x2="444" y1="40" y2="230" class="bien" />
      <text x="405" y="255">0,8</text><text x="535" y="255">1</text>
      <text x="80" y="65">xⁿ: n = 1, 4, 16, 64</text>
      <text x="75" y="285">Trên [0,0,8], sai số ≤ 0,8ⁿ → 0</text>
    </>}
    {loai === 'bernstein' && <>
      <path d="M60 30V230H550" class="net" />
      <path d={path(x=>x*x)} class="duong" />
      <path d={path(x=>(x*x+x)/2)} class="bien" />
      <text x="80" y="65">Nét liền: x²; nét đứt: B₂(x²)</text>
      <text x="75" y="275">B₂(x²) − x² = x(1−x)/2 ≤ 1/8</text>
    </>}
  </svg>
  <figcaption>{nhan}</figcaption>
</figure>
<style>
  figure { margin:24px 0; } svg { width:100%; height:auto; display:block; color:var(--text); }
  text { fill:currentColor; font:16px sans-serif; }
  .net,.duong,.bien { fill:none; stroke:currentColor; }
  .net { stroke-width:1.5; } .duong { stroke-width:2.5; }
  .bien { stroke-width:2; stroke-dasharray:6 5; opacity:.65; }
  .doan { stroke:currentColor; stroke-width:7; }
  .diem { fill:currentColor; } .rong { fill:var(--bg); stroke:currentColor; stroke-width:2; }
  .vung { fill:currentColor; fill-opacity:.1; stroke:currentColor; stroke-opacity:.3; }
  figcaption { color:var(--text-2); font-size:.9rem; text-align:center; }
</style>
