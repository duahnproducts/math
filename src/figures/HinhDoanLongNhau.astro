---
// Bài 4 — Đoạn đóng lồng nhau: luôn có một điểm nằm trong tất cả các đoạn.
const doan = [
  [40, 440],
  [110, 400],
  [170, 350],
  [215, 318],
  [238, 292],
];
const diem = 262;
---

<figure class="hinh" aria-labelledby="hinh-doan-cap">
  <svg viewBox="0 0 480 210" width="480" role="img" aria-label="Năm đoạn đóng lồng nhau, một đường thẳng đứng đi qua tất cả">
    {
      doan.map(([a, b], i) => (
        <g>
          <line x1={a} y1={30 + i * 34} x2={b} y2={30 + i * 34} class="net" stroke-width="2" />
          <line x1={a} y1={22 + i * 34} x2={a} y2={38 + i * 34} class="net" stroke-width="2" />
          <line x1={b} y1={22 + i * 34} x2={b} y2={38 + i * 34} class="net" stroke-width="2" />
          <text x={a - 8} y={34 + i * 34} text-anchor="end" class="chu-mo">
            I{i + 1}
          </text>
        </g>
      ))
    }
    <line x1={diem} y1="14" x2={diem} y2="190" class="nhan-manh" stroke-width="2" stroke-dasharray="4 4"></line>
    <text x={diem} y="206" text-anchor="middle" class="chu-nhan">x = sup các đầu mút trái</text>
  </svg>
  <figcaption id="hinh-doan-cap">
    Mỗi đoạn nằm trong đoạn trước, và mỗi đoạn đều có đủ hai đầu mút. Khi đó luôn có điểm x thuộc mọi đoạn.
  </figcaption>
</figure>
