---
// Đại số §2.6 — góc θ của đường thẳng y = mx: tam giác vuông cạnh 1 và m, cạnh
// huyền √(1 + m²), nên cos θ = 1/√(1 + m²), sin θ = m/√(1 + m²). Vẽ với m = 0,6.
import { cung } from './mui-ten';

const M = 0.6;
const O = { x: 40, y: 200 };
const DV = 200;
const P = { x: O.x + DV, y: O.y - M * DV };
const theta = Math.atan(M);
const dauDuong = { x: O.x - 25, y: O.y + 25 * M };
const cuoiDuong = { x: O.x + 1.2 * DV, y: O.y - 1.2 * DV * M };
const giuaHuyen = { x: (O.x + P.x) / 2, y: (O.y + P.y) / 2 };
---

<figure class="hinh" aria-labelledby="hinh-he-so-goc-cap" data-hinh-he-so-goc>
  <svg viewBox="0 0 300 225" width="300" role="img" aria-label="Đường thẳng y bằng m x tạo góc theta với trục x, tam giác vuông có cạnh 1 và m">
    <line x1="10" y1={O.y} x2="292" y2={O.y} class="net-mo" stroke-width="1" />
    <line x1={O.x} y1="218" x2={O.x} y2="20" class="net-mo" stroke-width="1" />
    <line x1={dauDuong.x} y1={dauDuong.y} x2={cuoiDuong.x} y2={cuoiDuong.y} class="nhan-manh" stroke-width="2" />
    <line x1={P.x} y1={P.y} x2={P.x} y2={O.y} class="net" stroke-width="1.3" stroke-dasharray="5 4" />
    <path d={`M${P.x - 10} ${O.y} L${P.x - 10} ${O.y - 10} L${P.x} ${O.y - 10}`} class="net-mo" stroke-width="1" style="fill: none" />
    <path d={cung(O.x, O.y, 42, 0, theta)} class="nhan-manh" stroke-width="1.3" style="fill: none" />
    <circle cx={P.x} cy={P.y} r="3.5" class="to-dam" />
    <text x={O.x + 56} y={O.y - 7} class="chu-nhan">θ</text>
    <text x={(O.x + P.x) / 2} y={O.y + 17} class="chu" text-anchor="middle">1</text>
    <text x={P.x + 8} y={(P.y + O.y) / 2 + 4} class="chu">m</text>
    <text x={giuaHuyen.x - 10} y={giuaHuyen.y - 12} class="chu" text-anchor="middle">√(1 + m²)</text>
    <text x={P.x + 10} y={P.y + 18} class="chu">(1, m)</text>
    <text x={cuoiDuong.x - 4} y={cuoiDuong.y - 8} class="chu-nhan" text-anchor="end">y = mx</text>
  </svg>
  <figcaption id="hinh-he-so-goc-cap">
    Đi 1 đơn vị theo trục x thì lên m đơn vị. Cạnh huyền dài √(1 + m²), nên cos θ = 1/√(1 + m²) và sin θ = m/√(1 + m²).
  </figcaption>
</figure>
