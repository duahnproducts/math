---
// Đại số Ví dụ 2.9.1 — xác suất ăn ở A vào ngày m, tính bằng s_(m+1) = P·s_m
// (src/lib/markov.ts): dao động rồi dồn về giá trị dừng 0.2.
import { P_VI_DU_2_9_1, dayTrangThai } from '@/lib/markov';

const SO_NGAY = 8;
const day = dayTrangThai(P_VI_DU_2_9_1, [0.5, 0.5], SO_NGAY).map((s) => s[0]);
const X0 = 48;
const BUOC_X = 32;
const Y0 = 176;
const CAO = 300; // pixel cho xác suất 1
const px = (m: number) => X0 + m * BUOC_X;
const py = (p: number) => Math.round((Y0 - p * CAO) * 10) / 10;
const diem = day.map((p, m) => ({ x: px(m), y: py(p), p }));
const duong = diem.map((d) => `${d.x},${d.y}`).join(' ');
---

<figure class="hinh" aria-labelledby="hinh-hoi-tu-markov-cap" data-hinh-hoi-tu-markov>
  <svg viewBox="0 0 330 210" width="330" role="img" aria-label="Xác suất ăn ở A theo ngày: 0.5, 0.125, 0.219, 0.195 rồi dồn về 0.2">
    <line x1={X0} y1={Y0} x2={px(SO_NGAY) + 14} y2={Y0} class="net-mo" stroke-width="1" />
    <line x1={X0} y1={Y0} x2={X0} y2={py(0.55)} class="net-mo" stroke-width="1" />
    <line x1={X0} y1={py(0.2)} x2={px(SO_NGAY) + 10} y2={py(0.2)} class="net-mo" stroke-width="1" stroke-dasharray="5 4" />
    {
      [0, 0.2, 0.4].map((p) => (
        <text x={X0 - 6} y={py(p) + 4} text-anchor="end" class="chu-mo">
          {p}
        </text>
      ))
    }
    <polyline points={duong} class="nhan-manh" stroke-width="1.6" style="fill: none" />
    {diem.map((d) => <circle cx={d.x} cy={d.y} r="3.5" class="to-nhan" />)}
    {
      diem.map((d, m) => (
        <text x={d.x} y={Y0 + 16} text-anchor="middle" class="chu-mo">
          {m}
        </text>
      ))
    }
    <text x={px(SO_NGAY) + 16} y={Y0 + 4} class="chu-mo">m</text>
    <text x={X0 + 6} y={py(0.55) + 4} class="chu-mo">xác suất ăn ở A</text>
    <text x={px(SO_NGAY)} y={py(0.2) - 8} text-anchor="middle" class="chu-nhan">0.2</text>
  </svg>
  <figcaption id="hinh-hoi-tu-markov-cap">
    Xác suất ông ăn ở A vào ngày m: bắt đầu 0.5, dao động rồi dồn về 0.2 — đó là vector trạng thái dừng.
  </figcaption>
</figure>
