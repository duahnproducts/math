---
// Liên kết chéo trong bài: <XemMuc muc="1.3" /> → "Đọc theo sách §1.3",
// <XemMuc bai={2} /> → "Học dễ hiểu ở Bài 2", <XemMuc bai-tap="1.3.6" /> → "Bài 1.3.6".
// Môn lấy từ đường dẫn trang hiện tại. Mục § và bài tập tự mang số chương nên trỏ
// được sang chương khác; bài giảng ở chương khác thì ghi thêm chuong={1}.
import { taoDuongDan, viTriTuUrl } from '@/lib/duong-dan';
import { chuongCuaMuc } from '@/lib/noi-dung';

interface Props {
  muc?: string;
  bai?: number;
  'bai-tap'?: string;
  /** chương của bài giảng, nếu khác chương đang đọc */
  chuong?: number;
  /** chữ hiển thị, nếu muốn khác mặc định */
  chu?: string;
}
const { muc, bai, 'bai-tap': baiTap, chuong, chu } = Astro.props;
const base = import.meta.env.BASE_URL;
const viTri = viTriTuUrl(Astro.url.pathname, base);
if (!viTri) throw new Error(`XemMuc chỉ dùng trong trang thuộc một chương: ${Astro.url.pathname}`);
const d = taoDuongDan(base);
const laGiaiTich = viTri.mon === 'giai-tich';

let href = '';
let mauChu = '';
if (muc) {
  href = d.sach(viTri.mon, chuongCuaMuc(muc), muc);
  mauChu = `${laGiaiTich ? 'Đọc theo sách' : 'Đọc nguyên văn'} §${muc}`;
} else if (bai) {
  const c = chuong ?? viTri.chuong;
  href = d.baiGiang(viTri.mon, c, bai);
  mauChu = c === viTri.chuong ? `Học dễ hiểu ở Bài ${bai}` : `Học dễ hiểu ở Bài ${bai}, Chương ${c}`;
} else if (baiTap) {
  href = d.baiTap(viTri.mon, chuongCuaMuc(baiTap), baiTap);
  mauChu = `Bài ${baiTap}`;
} else {
  throw new Error('XemMuc cần muc, bai hoặc bai-tap');
}
---

<a href={href} data-lien-ket-cheo>{chu ?? mauChu}</a>
