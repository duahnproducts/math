# Chép file này vào .hochanh-local/.env (thư mục đã được gitignore).
# Chỉ đặt khóa ở máy chủ; không thêm tiền tố PUBLIC_ hoặc VITE_.
# Mặc định đăng nhập bằng gói ChatGPT, không cần API key.
HOCHANH_CHAT_AUTH=chatgpt
# Đổi thành api nếu chủ ứng dụng muốn dùng khóa API thay cho gói ChatGPT.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
